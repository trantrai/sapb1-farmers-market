// ==================== SALES A/R — PHASE 2 (2026-10-17) ====================
// Hóa đơn đặt cọc phải thu (203/ODPI) + khấu trừ dần (DownPaymentsToDraw)
// khi xuất Hóa đơn bán hàng + lưu nháp (isDraft) cho mọi chứng từ.

model ArDownPayment {
  id              String              @id @default(cuid())
  docNum          Int?                @unique // null = nháp (isDraft), cấp số thật khi finalize
  isDraft         Boolean             @default(false) // true = nháp, chưa có số chính thức, không đẩy SAP
  cardCode        String
  cardName        String
  docDate         DateTime
  docDueDate      DateTime
  status          String              @default("Open") // Open | Closed | Cancelled
  version         Int                 @default(0) // Optimistic locking: tăng mỗi lần update
  remarks         String?
  // --- B2B / SAP B1 mở rộng (Đợt 2+3, 2026-10-17) ---
  salesPersonCode Int?     // Nhân viên bán hàng (SAP SalesPersonCode)
  paymentGroupCode Int?    // Điều khoản thanh toán (SAP PaymentGroupCode)
  shipToCode      String?  // Địa chỉ giao hàng (SAP ShipToCode)
  billToCode      String?  // Địa chỉ ghi hóa đơn (SAP BillToCode)
  numAtCard       String?  // Số PO / tham chiếu của KH (SAP NumAtCard)
  taxDate         DateTime? // Ngày tính thuế (SAP TaxDate)
  docCurrency     String?  @default("VND") // Tiền tệ chứng từ (SAP DocCurrency)
  docRate         Float?   @default(1)     // Tỷ giá (SAP DocRate)
  projectCode     String?  // Mã dự án (SAP ProjectCode)
  attachmentsJson String?  // Đính kèm gọn [{name,url}] (thay SAP AttachmentEntry)
  paidAmount      Float     @default(0) // Số tiền đã thu
  paymentStatus   String    @default("unpaid") // unpaid | partial | paid
  warehouseCode   String?
  totalBeforeDisc Float               @default(0)
  discountAmt     Float               @default(0)
  headerDiscPct   Float               @default(0)
  headerDiscAmt   Float               @default(0)
  vatAmt          Float               @default(0)
  grandTotal      Float               @default(0)
  /** Số tiền cọc còn lại chưa khấu trừ — khởi tạo = grandTotal, trừ dần mỗi lần hóa đơn draw */
  remainingAmount Decimal             @default(0)
  // --- Chứng từ nguồn (tương đương BaseType/BaseEntry SAP) ---
  sourceQuotationId String?           // Copy từ Báo giá
  sourceOrderId     String?           // Copy từ Đơn hàng bán
  createdBy       String
  // --- Đồng bộ SAP B1 (POST /DownPayments → ODPI) ---
  sapDocEntry     Int?
  sapDocNum       Int?
  sapSyncStatus   String              @default("none") // none | pending | synced
  sapSyncError    String?
  sapSyncedAt     DateTime?
  sapDatabaseId   String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  lines           ArDownPaymentLine[]
  draws           DownPaymentDraw[]   // Các lần hóa đơn khấu trừ từ đặt cọc này

  @@index([sapDatabaseId, status])
  @@index([cardCode, docDate])
  @@index([docNum])
  @@index([sourceQuotationId])
  @@index([sourceOrderId])
}

model ArDownPaymentLine {
  id              String        @id @default(cuid())
  downPaymentId   String
  lineNum         Int
  itemCode        String
  itemName        String
  uom             String        @default("kg")
  warehouseCode   String?
  taxCode         String?
  quantity        Float
  unitPrice       Float
  lineTotal       Float
  discPct         Float         @default(0)
  discAmt         Float         @default(0)
  vatPct          Float         @default(8)
  vatAmt          Float         @default(0)
  grandTotal      Float         @default(0)
  downPayment     ArDownPayment @relation(fields: [downPaymentId], references: [id], onDelete: Cascade)
  sapLineNum      Int?
  isBomChild      Boolean       @default(false)
  bomGroupKey     String?
  bomEditable     Boolean       @default(true)
  bomQtyPerParent Float?
  sourceLineId    String?       // id dòng chứng từ nguồn (tương đương BaseLine SAP)

  @@index([downPaymentId])
  @@index([sourceLineId])
}

// Bảng trung gian: Hóa đơn bán hàng khấu trừ bao nhiêu từ Hóa đơn đặt cọc nào.
// Tương đương DownPaymentsToDraw của Service Layer khi POST /Invoices.
model DownPaymentDraw {
  id            String        @id @default(cuid())
  invoiceId     String
  invoice       ArInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  downPaymentId String
  downPayment   ArDownPayment @relation(fields: [downPaymentId], references: [id], onDelete: Cascade)
  drawAmount    Decimal       // Số tiền khấu trừ từ đặt cọc này
  createdAt     DateTime      @default(now())

  @@index([invoiceId])
  @@index([downPaymentId])
}

// ==================== DÃY ĐÁNH SỐ CHỨNG TỪ (Phase 1 Sales A/R) ====================
// Mỗi loại chứng từ có dãy số RIÊNG (tương đương Numbering Series SAP B1),
// không dùng chung dãy docNum với Đơn hàng/Phiếu giao hàng.
// Phase 2: thêm dãy 'downPayment' cho Hóa đơn đặt cọc phải thu.
model DocNumSequence {
  id        String   @id @default(cuid())
  docType   String   @unique // quotation | invoice | creditMemo | return | downPayment
  lastNum   Int      @default(0)
  updatedAt DateTime @updatedAt
}


// Nhân viên bán hàng — đồng bộ từ SAP B1 OSLP (Đợt 2)
model SalesPerson {
  id            String   @id @default(cuid())
  code          Int      @unique // SAP OSLP.SlpCode
  name          String   // SAP OSLP.SlpName
  active        Boolean  @default(true)
  sapDatabaseId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sapDatabaseId])
}

// Lịch sử ghi nhận thanh toán cho hóa đơn/ghi có/đặt cọc (Đợt 2, MỤC 11)
model PaymentRecord {
  id        String   @id @default(cuid())
  docType   String   // invoice | creditMemo | downPayment
  docId     String   // id chứng từ
  amount    Float
  payDate   DateTime @default(now())
  remarks   String?
  createdBy String
  createdAt DateTime @default(now())

  @@index([docType, docId])
}

// Điều khoản thanh toán — đồng bộ từ SAP B1 OCTG (Đợt 2, MỤC 7)
model PaymentTerm {
  id            String   @id @default(cuid())
  code          Int      @unique // SAP OCTG.GroupNum
  name          String   // SAP OCTG.PymntGroup
  /** Số ngày cộng vào ngày chứng từ để tính ngày đáo hạn (chuẩn SAP B1:
   * DueDate = StartFrom + NumberOfAdditionalMonths + NumberOfAdditionalDays;
   * tháng quy đổi xấp xỉ 30 ngày) */
  days          Int      @default(0) // = NumberOfAdditionalMonths*30 + NumberOfAdditionalDays
  /** Mốc tính ngày đáo hạn: 'docDate' (mặc định) | 'taxDate' — theo SAP OCTG.BaselineDate */
  dueDateBase   String   @default("docDate")
  sapDatabaseId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sapDatabaseId])
}
