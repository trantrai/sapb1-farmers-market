generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== USERS & AUTH ====================

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String // sha256(password + salt)
  fullName  String
  role      String // Admin | KeToan | NhanVien | …
  active    Boolean  @default(true) // false = vô hiệu hóa, không cho đăng nhập
  /** true = tài khoản phải đổi mật khẩu ngay ở lần đăng nhập tiếp theo (seed/mật khẩu tạo bởi admin) */
  mustChangePassword Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== MASTER DATA (SAP B1 mirror) ====================

model BusinessPartner {
  id        String    @id @default(cuid())
  sapDatabaseId String @default("") // DB SAP nguồn của bản ghi ("" = dữ liệu cũ chưa gán)
  cardCode  String // C20001
  cardName  String
  address   String?
  groupNum      Int?    // Điều khoản thanh toán (SAP OCRD.GroupNum)
  addressesJson String? // Địa chỉ giao/nhận hàng JSON (SAP BPAddresses)
  phone     String?
  email     String?   // EmailAddress (dòng đồng bộ từ SAP B1)
  contactPerson String? // Người liên hệ chính (ContactEmployees[0].Name trên SAP B1)
  contactPhone  String? // SĐT người liên hệ (ContactEmployees[0].Phone1/MobilePhone)
  groupType String    @default("Khách hàng") // Khách hàng | Nhà cung cấp
  syncedAt  DateTime? // Lần cuối dòng này được đồng bộ từ SAP B1

  @@unique([sapDatabaseId, cardCode]) // cùng CardCode có thể tồn tại ở nhiều DB
}

model VatGroup {
  id        String    @id @default(cuid())
  sapDatabaseId String @default("") // DB SAP nguồn của bản ghi ("" = dữ liệu cũ chưa gán)
  code      String    // OVTG.Code (S1/S2/S8…)
  category  String    @default("S") // OVTG.Category: S = Bán (output) | P = Mua (input)
  name      String    @default("") // OVTG.Name
  rate      Float?    // Thuế suất % hiệu lực hôm nay (nguồn VTG1 /VatGroups_Lines)
  syncedAt  DateTime? // Lần cuối dòng này được đồng bộ từ SAP B1

  @@unique([sapDatabaseId, code, category]) // 1 mã thuế có 2 dòng S/P (có thể khác suất)
}

model Item {
  id        String    @id @default(cuid())
  sapDatabaseId String @default("") // DB SAP nguồn của bản ghi ("" = dữ liệu cũ chưa gán)
  itemCode  String // FM-RAU-001
  itemName  String
  uom       String    @default("kg") // Đơn vị tính (SalesUnit / InventoryUOM)
  price     Float     @default(0) // Đơn giá VND (Price List 1)
  stock     Float     @default(0) // Tồn kho (QuantityOnStock)
  category  String?
  taxCode   String?   // Mã nhóm thuế bán (SalesVATGroup, vd S2/S8)
  barcode   String?   // Mã vạch (BarCode)
  syncedAt  DateTime? // Lần cuối dòng này được đồng bộ từ SAP B1
  /** Loại BOM theo SAP B1 ProductTrees: none | template (iTemplateTree) | production (iProductionTree) */
  bomType   String    @default("none")

  @@unique([sapDatabaseId, itemCode]) // cùng ItemCode có thể tồn tại ở nhiều DB
}

// ==================== BOM (định mức nguyên vật liệu — SAP B1 ProductTrees) ====================
// Lưu công thức BOM đã chuẩn hóa: số lượng con cho 1 ĐƠN VỊ cha
// (= ProductTreeLines.Quantity / ProductTrees.Quantity).
model BomComponent {
  id            String @id @default(cuid())
  sapDatabaseId String @default("") // DB SAP nguồn ("" = dữ liệu cũ chưa gán)
  parentItemCode String // TreeCode — mã mặt hàng cha (mặt hàng BOM)
  childItemCode  String // mã thành phần con
  childItemName  String @default("")
  /** Số lượng con cho 1 đơn vị cha (đã chuẩn hóa theo Tree Quantity) */
  quantity      Float
  uom           String @default("")
  sortOrder     Int    @default(0)
  syncedAt      DateTime?

  @@unique([sapDatabaseId, parentItemCode, childItemCode])
  @@index([sapDatabaseId, parentItemCode])
}

// ==================== SALE ORDER ====================

model SalesOrder {
  id              String           @id @default(cuid())
  docNum          Int?             @unique // null = nháp (isDraft), cấp số thật khi finalize
  isDraft         Boolean          @default(false) // true = nháp (ODRF/112), chưa có số chính thức, không đẩy SAP
  cardCode        String
  cardName        String
  docDate         DateTime
  docDueDate      DateTime
  status          String           @default("Open") // Open | Closed | Cancelled
  version         Int              @default(0) // Optimistic locking: tăng mỗi lần update
  remarks         String?
  // --- B2B / SAP B1 mở rộng (Đợt 2+3, 2026-10-17) ---
  salesPersonCode Int?     // Nhân viên bán hàng (SAP SalesPersonCode)
  paymentGroupCode Int?    // Điều khoản thanh toán (SAP PaymentGroupCode)
  shipToCode      String?  // Địa chỉ giao hàng (SAP ShipToCode)
  billToCode      String?  // Địa chỉ ghi hóa đơn (SAP BillToCode)
  numAtCard       String?  // Số PO / tham chiếu của KH (SAP NumAtCard)
  taxDate         DateTime? // Ngày tính thuế (SAP TaxDate)
  docCurrency     String?  @default("VND") // Tiền tệ chứng từ (SAP DocCurrency)
  docRate         Float?   @default(1)     // Tỷ giá (SAP DocRate)
  projectCode     String?  // Mã dự án (SAP ProjectCode)
  attachmentsJson String?  // Đính kèm gọn [{name,url}] (thay SAP AttachmentEntry)
  reqDate         DateTime? // Ngày cần giao (SAP ReqDate)
  warehouseCode   String?          // Kho hàng xuất bán mặc định áp dụng cho các dòng hàng (WarehouseCode)
  totalBeforeDisc Float            @default(0) // Tổng trước chiết khấu (sum lineTotal)
  discountAmt     Float            @default(0) // Tổng chiết khấu các dòng
  headerDiscPct   Float            @default(0) // Chiết khấu ĐẦU CHỨNG TỪ % (SAP: Documents.DiscountPercent)
  headerDiscAmt   Float            @default(0) // Số tiền CK đầu chứng từ sau phân bổ về các dòng
  vatAmt          Float            @default(0) // Tổng thuế VAT các dòng
  grandTotal      Float            @default(0) // Tổng cộng (sau CK + VAT)
  createdBy       String
  // --- Đồng bộ SAP B1 (POST /Orders → ORDR) ---
  sapDocEntry     Int?             // DocEntry do SAP B1 cấp khi đẩy thành công
  sapDocNum       Int?             // DocNum chứng từ trên SAP B1
  sapSyncStatus   String           @default("none") // none = chưa cấu hình SAP | pending = đẩy chưa thành công | synced = đã đẩy OK
  sapSyncError    String?          // Lỗi lần đẩy gần nhất (nếu có)
  sapSyncedAt     DateTime?        // Thời điểm đẩy thành công
  sapDatabaseId   String?          // DB SAP đích của đơn (đẩy/retry luôn dùng DB này)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lines           SalesOrderLine[]
  deliveries      Delivery[]

  // M14: index cho query thực tế
  @@index([sapDatabaseId, status])
  @@index([cardCode, docDate])
  @@index([sapSyncStatus, sapDocEntry])
  @@index([docNum])
}

// ============================================================
// DELIVERY (phiếu giao hàng) — copy từ Sales Order, đẩy sang SAP B1 (/DeliveryNotes → ODLN)
// ============================================================
model Delivery {
  id            String    @id @default(cuid())
  docNum        Int?      @unique // null = nháp (isDraft), cấp số thật khi finalize (cấp thủ công: max+1)
  isDraft       Boolean   @default(false) // true = nháp, chưa có số chính thức, không đẩy SAP
  docDate       DateTime  @default(now())
  cardCode      String
  cardName      String
  warehouseCode String? // Kho xuất hàng header (SAP DeliveryNotes.WarehouseCode) — mặc định áp cho các dòng
  status        String    @default("Open") // Open | Closed | Cancelled
  version       Int       @default(0) // Optimistic locking: tăng mỗi lần update
  remarks       String?
  // --- B2B / SAP B1 mở rộng (Đợt 2+3, 2026-10-17) ---
  salesPersonCode Int?     // Nhân viên bán hàng (SAP SalesPersonCode)
  paymentGroupCode Int?    // Điều khoản thanh toán (SAP PaymentGroupCode)
  shipToCode      String?  // Địa chỉ giao hàng (SAP ShipToCode)
  billToCode      String?  // Địa chỉ ghi hóa đơn (SAP BillToCode)
  numAtCard       String?  // Số PO / tham chiếu của KH (SAP NumAtCard)
  taxDate         DateTime? // Ngày tính thuế (SAP TaxDate)
  docCurrency     String?  @default("VND") // Tiền tệ chứng từ (SAP DocCurrency)
  docRate         Float?   @default(1)     // Tỷ giá (SAP DocRate)
  projectCode     String?  // Mã dự án (SAP ProjectCode)
  attachmentsJson String?  // Đính kèm gọn [{name,url}] (thay SAP AttachmentEntry)
  reqDate         DateTime? // Ngày cần giao (SAP ReqDate)
  pickAndPackNotes String?  // Ghi chú soạn/đóng gói (SAP PickAndPackNotes)
  headerDiscPct   Float     @default(0) // CK đầu chứng từ % (SAP DiscountPercent)
  // Liên kết đơn hàng nguồn (1 đơn có thể có nhiều delivery)
  sourceOrderId String?
  sourceOrder   SalesOrder? @relation(fields: [sourceOrderId], references: [id])
  // Liên kết báo giá nguồn (copy-from theo ma trận SAP B1: Delivery ← Quotation)
  sourceQuotationId String?
  sourceQuotation   Quotation? @relation(fields: [sourceQuotationId], references: [id])
  // Đơn SAP B1 trực tiếp (id 'sap-<DocEntry>', chưa có bản ghi local):
  // lưu DocEntry đơn nguồn để tính OpenQty và liên kết
  sapSourceDocEntry Int?
  // Đồng bộ SAP B1 (POST /DeliveryNotes → ODLN)
  sapDocEntry   Int?
  sapDocNum     Int?
  sapSyncStatus String    @default("none") // none | pending | synced
  sapSyncError  String?
  sapSyncedAt   DateTime?
  sapDatabaseId String?
  grandTotal    Float     @default(0)
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lines         DeliveryLine[]

  @@index([sapDatabaseId, status])
  @@index([sourceOrderId])
  @@index([sourceQuotationId])
  @@index([sapSourceDocEntry])
  @@index([cardCode, docDate])
  @@index([cardName]) // tìm kiếm/lọc theo tên khách hàng trên danh sách Giao hàng
}

model DeliveryLine {
  id         String   @id @default(cuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  lineNum    Int
  itemCode   String
  itemName   String
  quantity   Float
  uom        String   @default("")
  unitPrice  Float    @default(0)
  lineTotal  Float    @default(0)
  taxCode    String? // Mã nhóm thuế SAP (Delivery VAT Group) → VatGroup khi đẩy
  discPct    Float    @default(0) // Chiết khấu % theo dòng → DiscountPercent khi đẩy
  // Liên kết dòng đơn nguồn — để tính OpenQty (đã giao bao nhiêu)
  sourceOrderLineId String?
  // Liên kết dòng báo giá nguồn (copy-from: Delivery ← Quotation)
  sourceQuotationLineId String?
  // Kho xuất của dòng (SAP DocumentLines.WarehouseCode) — mặc định theo kho header
  warehouseCode String?

  batchNumber String? // Số lô (SAP BatchNumbers) — truy xuất nguồn gốc
  @@index([deliveryId])
  @@index([sourceOrderLineId])
  @@index([sourceQuotationLineId])
}

model SalesOrderLine {
  id         String     @id @default(cuid())
  orderId    String
  lineNum    Int
  itemCode   String
  itemName   String
  uom        String     @default("kg")
  warehouseCode String? // Kho xuất của dòng (WarehouseCode) — mặc định lấy từ header, chỉnh được theo dòng
  taxCode    String?    // Mã nhóm thuế SAP (SalesVATGroup) → VatGroup khi đẩy đơn
  quantity   Float
  unitPrice  Float
  lineTotal  Float // Thành tiền trước CK = quantity × unitPrice
  discPct    Float      @default(0) // Chiết khấu % theo dòng
  discAmt    Float      @default(0)
  vatPct     Float      @default(8) // Thuế suất VAT % theo dòng
  vatAmt     Float      @default(0)
  grandTotal Float      @default(0) // Sau CK + VAT của dòng
  order      SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sapLineNum Int?       // LineNum do SAP B1 cấp khi đẩy đơn (PATCH /Orders khi sửa đơn cần LineNum)
  // Local id dòng báo giá nguồn (copy-to: Order ← Quotation) — dùng tra
  // BaseType/BaseEntry/BaseLine khi đẩy đơn lên SAP (dòng null = đơn độc lập)
  sourceLineId String?
  // ---------- Dòng thành phần BOM ----------
  isBomChild  Boolean @default(false) // true = dòng thành phần con của mặt hàng BOM
  bomGroupKey String?  // khóa nhóm: dòng cha và các dòng con cùng nhóm BOM
  bomEditable Boolean @default(true)  // cho phép sửa SL con (BOM Template) hay không (BOM Production)
  bomQtyPerParent Float? // định mức: số lượng con cho 1 đơn vị cha (để quy đổi lại khi sửa SL cha)

  @@index([orderId])
}

// ==================== SAP SERVICE LAYER AUDIT ====================

// Nhật ký mọi lệnh gọi Service Layer (POST luôn ghi, GET chỉ ghi khi LỖI).
// Dùng cho màn hình "Service Layer Audit" — xem lỗi và Retry gửi lại payload.
model SapAuditLog {
  id            String   @id @default(cuid())
  method        String // POST | GET
  path          String // /Orders, /Login, /InventoryItems?... (GET lưu kèm query để Retry)
  ok            Boolean
  httpStatus    Int? // mã HTTP của SL (0 = lỗi mạng/timeout)
  durationMs    Int      @default(0)
  error         String? // thông báo lỗi tiếng Việt
  payload       String? // JSON body đã gửi (POST) — để Retry; đã CHE mật khẩu
  resultSummary String? // tóm tắt kết quả (DocEntry/DocNum/số bản ghi…)
  retryOf       String? // id của bản ghi gốc nếu đây là lệnh Retry
  // DB (CompanyDB) đã dùng cho lệnh gọi này — Retry phải dùng đúng DB gốc
  // (nullable: dữ liệu audit cũ không có DB thì fallback DB của phiên hiện tại)
  sapDatabaseId String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

// ==================== SETTINGS (SAP B1 Service Layer) ====================

// ==================== SAP DATABASES (multi-CompanyDB) ====================
// Danh sách kết nối Service Layer do Admin khai báo. Đăng nhập chọn 1 DB;
// mọi thao tác SAP (đẩy đơn, đồng bộ, tra cứu) dùng đúng DB đã chọn.
// Mirror tables (Item/BusinessPartner/VatGroup) tách theo sapDatabaseId.
model SapDatabase {
  id              String   @id @default(cuid())
  label           String   // Tên hiển thị: "Kho HCM — LIVE"
  serviceLayerUrl String
  companyDb       String
  sapUser         String
  sapPassword     String   @default("") // mã hóa AES-256-GCM (fm-crypto)
  sslSkipVerify   Boolean  @default(false)
  isDefault       Boolean  @default(false)
  connected       Boolean  @default(false) // Kết quả test kết nối gần nhất
  lastTestAt      DateTime? // Thời điểm test kết nối gần nhất
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([serviceLayerUrl, companyDb, sapUser]) // tránh khai báo trùng connection
}

// ==================== ĐỒNG BỘ GIA TĂNG (delta sync) ====================

/// Mốc thay đổi (watermark) cho đồng bộ gia tăng master data từ SAP B1.
/// Mỗi (database SAP, entity) giữ một mốc (UpdateDate, UpdateTime) lớn nhất
/// đã đồng bộ — lượt sync gia tăng chỉ tải các bản ghi
/// UpdateDate > D, hoặc UpdateDate = D và UpdateTime > T.
model SyncWatermark {
  id            String    @id @default(cuid())
  sapDatabaseId String    // DB SAP nguồn
  entity        String    // 'items' | 'partners' | 'vatgroups'
  /// UpdateDate (YYYY-MM-DD, theo giờ máy chủ SAP) lớn nhất đã đồng bộ
  lastUpdateDate String?
  /// UpdateTime (số nguyên HHMMSS, vd 143025 = 14:30:25) lớn nhất tại lastUpdateDate
  lastUpdateTime Int?
  /// Chế độ của lượt sync gần nhất: 'full' | 'incremental'
  lastMode      String?
  lastSyncAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([sapDatabaseId, entity])
}

model AppSettings {
  id              String    @id @default("main")
  serviceLayerUrl String    @default("")
  companyDb       String    @default("")
  sapUser         String    @default("")
  sapPassword     String    @default("")
  sslSkipVerify   Boolean   @default(false) // Bỏ qua xác thực chứng chỉ SSL (self-signed)
  connected       Boolean   @default(false)
  lastSyncAt      DateTime?
  // --- Gợi ý mặt hàng theo lịch sử đơn hàng ---
  suggestHistoryDays Int    @default(90) // Khoảng thời gian lịch sử (ngày)
  suggestMaxItems    Int    @default(10) // Số mặt hàng gợi ý tối đa
  // --- Cấu hình Email (SMTP) ---
  smtpHost      String    @default("") // vd: smtp.gmail.com
  smtpPort      Int       @default(587)
  smtpUser      String    @default("")
  smtpPass      String    @default("")
  smtpFromEmail String    @default("")
  smtpFromName  String    @default("") // vd: Farmers Market
  // --- Base Workflow API (module Import BOM) ---
  baseTokenEnc  String    @default("") // Access Token v2 Base.vn, mã hóa AES-256-GCM (fm-crypto)
  updatedAt     DateTime  @updatedAt
}

// ==================== RBAC ====================

model Role {
  id          String  @id @default(cuid())
  name        String  @unique // Admin | KeToan | NhanVien
  label       String
  permissions String // JSON: { [module]: { view, create, edit, delete } }
  builtin     Boolean @default(false)
}

// ==================== EXCEL TEMPLATES ====================

model ExcelTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  isDefault   Boolean  @default(false)
  mapping     String   // JSON: { "excelColumn": "fieldName" }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== ORDER TEMPLATES ====================

// Mẫu đơn hàng — lưu đơn thường lặp lại để tạo nhanh.
// lines: JSON array [{ itemCode, itemName, quantity, unitPrice, discPct, vatPct, uom, taxCode, warehouseCode }]
model OrderTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  cardCode    String?
  cardName    String?
  lines       String   // JSON array of line items
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== IMPORT BOM (Base Workflow → SAP B1) ====================

// Một lượt chạy pipeline Import BOM: ingest → (gate 1) → parse → validate →
// (gate 2, Sprint 2) → apply B1 (Sprint 3). Mọi JSON lưu dạng chuỗi.
model ImportRun {
  id                 String    @id @default(cuid())
  jobId              String    // Base Workflow job id (vd "4818871")
  jobName            String?   // Tên job lấy từ Base API
  sapDatabaseId      String?   // DB SAP đích (null = DB mặc định)
  status             String    @default("ingesting") // ingesting|ingested|confirmed|parsed|validated|applying|applied|failed|rolledback|cancelled
  sourceFiles        String    @default("[]") // JSON: [{ field, filename, md5, sha256, bytes, downloadedAt }]
  canonicalRef       String?   // Đường dẫn tương đối file canonical JSON (data/bom-import/<jobId>/<runId>.canonical.json)
  decisions          String    @default("[]") // JSON snapshot 17 quyết định (F8)
  createdKeys        String    @default("[]") // JSON: mã đã tạo bởi run này (cho rollback Sprint 3)
  crossChecksSummary String?   // JSON tóm tắt đối chiếu báo giá (Sprint 2)
  startedBy          String    // username người tạo run
  createdAt          DateTime  @default(now())
  finishedAt         DateTime?

  @@index([jobId])
  @@index([status])
}

// ==================== SALES A/R — PHASE 1 (2026-10-17) ====================
// 4 chứng từ mới: Báo giá bán hàng (23/OQUT), Hóa đơn bán hàng (13/OINV),
// Phiếu ghi có phải thu (14/ORIN), Phiếu trả hàng bán (16/ORDN).
// Cấu trúc sao chép SalesOrder/SalesOrderLine; dãy docNum RIÊNG theo loại
// chứng từ qua DocNumSequence (không dùng chung dãy với Đơn hàng).
// Đẩy SAP Service Layer: bổ sung ở bước tích hợp (WORKER C).

model Quotation {
  id              String          @id @default(cuid())
  docNum          Int?            @unique // null = nháp (isDraft), cấp số thật khi finalize
  isDraft         Boolean         @default(false) // true = nháp, chưa có số chính thức, không đẩy SAP
  cardCode        String
  cardName        String
  docDate         DateTime
  docDueDate      DateTime
  status          String          @default("Open") // Open | Closed | Cancelled
  version         Int             @default(0) // Optimistic locking: tăng mỗi lần update
  remarks         String?
  // --- B2B / SAP B1 mở rộng (Đợt 2+3, 2026-10-17) ---
  salesPersonCode Int?     // Nhân viên bán hàng (SAP SalesPersonCode)
  paymentGroupCode Int?    // Điều khoản thanh toán (SAP PaymentGroupCode)
  shipToCode      String?  // Địa chỉ giao hàng (SAP ShipToCode)
  billToCode      String?  // Địa chỉ ghi hóa đơn (SAP BillToCode)
  numAtCard       String?  // Số PO / tham chiếu của KH (SAP NumAtCard)
  taxDate         DateTime? // Ngày tính thuế (SAP TaxDate)
  docCurrency     String?  @default("VND") // Tiền tệ chứng từ (SAP DocCurrency)
  docRate         Float?   @default(1)     // Tỷ giá (SAP DocRate)
  projectCode     String?  // Mã dự án (SAP ProjectCode)
  attachmentsJson String?  // Đính kèm gọn [{name,url}] (thay SAP AttachmentEntry)
  warehouseCode   String?         // Kho hàng mặc định áp dụng cho các dòng hàng
  totalBeforeDisc Float           @default(0) // Tổng trước chiết khấu (sum lineTotal)
  discountAmt     Float           @default(0) // Tổng chiết khấu các dòng
  headerDiscPct   Float           @default(0) // Chiết khấu ĐẦU CHỨNG TỪ % (SAP: Documents.DiscountPercent)
  headerDiscAmt   Float           @default(0) // Số tiền CK đầu chứng từ sau phân bổ về các dòng
  vatAmt          Float           @default(0) // Tổng thuế VAT các dòng
  grandTotal      Float           @default(0) // Tổng cộng (sau CK + VAT)
  createdBy       String
  // --- Đồng bộ SAP B1 (POST /Quotations → OQUT) ---
  sapDocEntry     Int?            // DocEntry do SAP B1 cấp khi đẩy thành công
  sapDocNum       Int?            // DocNum chứng từ trên SAP B1
  sapSyncStatus   String          @default("none") // none | pending | synced
  sapSyncError    String?         // Lỗi lần đẩy gần nhất (nếu có)
  sapSyncedAt     DateTime?       // Thời điểm đẩy thành công
  sapDatabaseId   String?         // DB SAP đích của chứng từ
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lines           QuotationLine[]
  deliveries      Delivery[] // Phiếu giao hàng copy từ báo giá này

  @@index([sapDatabaseId, status])
  @@index([cardCode, docDate])
  @@index([docNum])
}

model QuotationLine {
  id              String    @id @default(cuid())
  quotationId     String
  lineNum         Int
  itemCode        String
  itemName        String
  uom             String    @default("kg")
  warehouseCode   String?   // Kho xuất của dòng
  taxCode         String?   // Mã nhóm thuế SAP (SalesVATGroup)
  quantity        Float
  unitPrice       Float
  lineTotal       Float     // Thành tiền trước CK = quantity × unitPrice
  discPct         Float     @default(0) // Chiết khấu % theo dòng
  discAmt         Float     @default(0)
  vatPct          Float     @default(8) // Thuế suất VAT % theo dòng
  vatAmt          Float     @default(0)
  grandTotal      Float     @default(0) // Sau CK + VAT của dòng
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  sapLineNum      Int?      // LineNum do SAP B1 cấp khi đẩy chứng từ
  // ---------- Dòng thành phần BOM ----------
  isBomChild      Boolean   @default(false)
  bomGroupKey     String?
  bomEditable     Boolean   @default(true)
  bomQtyPerParent Float?
  // Liên kết dòng chứng từ nguồn (tương đương BaseLine SAP)
  sourceLineId    String?

  @@index([quotationId])
  @@index([sourceLineId])
}

model ArInvoice {
  id              String        @id @default(cuid())
  docNum          Int?          @unique // null = nháp (isDraft), cấp số thật khi finalize
  isDraft         Boolean       @default(false) // true = nháp, chưa có số chính thức, không đẩy SAP
  /** Loại hóa đơn: Item (hàng hóa) | Service (dịch vụ) | Reserve (hóa đơn dự trữ → SAP ReserveInvoice=tYES) */
  docType         String        @default("Item")
  cardCode        String
  cardName        String
  docDate         DateTime
  docDueDate      DateTime
  status          String        @default("Open") // Open | Closed | Cancelled
  version         Int           @default(0) // Optimistic locking: tăng mỗi lần update
  remarks         String?
  // --- B2B / SAP B1 mở rộng (Đợt 2+3, 2026-10-17) ---
  salesPersonCode Int?     // Nhân viên bán hàng (SAP SalesPersonCode)
  paymentGroupCode Int?    // Điều khoản thanh toán (SAP PaymentGroupCode)
  shipToCode      String?  // Địa chỉ giao hàng (SAP ShipToCode)
  billToCode      String?  // Địa chỉ ghi hóa đơn (SAP BillToCode)
  numAtCard       String?  // Số PO / tham chiếu của KH (SAP NumAtCard)
  taxDate         DateTime? // Ngày tính thuế (SAP TaxDate)
  docCurrency     String?  @default("VND") // Tiền tệ chứng từ (SAP DocCurrency)
  docRate         Float?   @default(1)     // Tỷ giá (SAP DocRate)
  projectCode     String?  // Mã dự án (SAP ProjectCode)
  attachmentsJson String?  // Đính kèm gọn [{name,url}] (thay SAP AttachmentEntry)
  warehouseCode   String?
  totalBeforeDisc Float         @default(0)
  discountAmt     Float         @default(0)
  headerDiscPct   Float         @default(0)
  headerDiscAmt   Float         @default(0)
  vatAmt          Float         @default(0)
  grandTotal      Float         @default(0)
  // --- Công nợ (dự phòng Phase 3: tuổi nợ phải thu) ---
  paidAmount      Float         @default(0) // Số tiền đã thu
  paymentStatus   String        @default("unpaid") // unpaid | partial | paid
  // --- Chứng từ nguồn (tương đương BaseType/BaseEntry SAP) ---
  sourceQuotationId String?     // Copy từ Báo giá
  sourceOrderId     String?     // Copy từ Đơn hàng bán
  sourceDeliveryId  String?     // Copy từ Phiếu giao hàng
  createdBy       String
  // --- Đồng bộ SAP B1 (POST /Invoices → OINV) ---
  sapDocEntry     Int?
  sapDocNum       Int?
  sapSyncStatus   String        @default("none") // none | pending | synced
  sapSyncError    String?
  sapSyncedAt     DateTime?
  sapDatabaseId   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lines           ArInvoiceLine[]
  draws           DownPaymentDraw[] // Khấu trừ đặt cọc (DownPaymentsToDraw khi đẩy SAP)

  @@index([sapDatabaseId, status])
  @@index([cardCode, docDate])
  @@index([docNum])
  @@index([sourceQuotationId])
  @@index([sourceOrderId])
  @@index([sourceDeliveryId])
}

model ArInvoiceLine {
