# Copy file này thành .env và điền giá trị thật TRÊN MÁY CỦA BẠN.
# .env đã được .gitignore chặn — không commit, không gửi qua chat.
# Kết nối SAP B1 (URL, CompanyDB, user, password) cấu hình trong app, lưu mã hoá trong DB — không đặt ở đây.

# --- Database (Prisma, SQLite) ---
DATABASE_URL="file:../db/custom.db"

# --- Bảo mật app ---
FM_SESSION_SECRET=
# Khoá mã hoá dữ liệu nhạy cảm (credential B1 trong DB). Bỏ trống thì dùng FM_SESSION_SECRET.
FM_DATA_KEY=

# --- Tuỳ chọn ---
# SAP_BATCH_SIZE=500
# FM_PHASE2_TEST_DB=1
